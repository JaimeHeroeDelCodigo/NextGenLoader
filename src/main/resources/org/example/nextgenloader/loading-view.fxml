<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<?import javafx.scene.text.Font?>
<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.nextgenloader.LoadingController"
            prefHeight="485.0" prefWidth="300.0">

    <VBox alignment="CENTER" spacing="20.0"  xmlns:fx="http://javafx.com/fxml">
        <HBox alignment="TOP_CENTER" maxWidth="Infinity">
            <Label fx:id="loadingLabel" text="Loading Files" textAlignment="JUSTIFY">
                <font>
                    <Font name="Times New Roman" size="30.0" />
                </font>
            </Label>
        </HBox>


        <HBox alignment="CENTER" spacing="15.0" xmlns:fx="http://javafx.com/fxml">
            <padding>
                <Insets top="10" bottom="10" right="10" left="10"/>
            </padding>

            <Button fx:id="lastFileButton" text="Last file" onAction="#lastFile"/>
            <ListView fx:id="fileListView" />
            <Button fx:id="nextFileButton" text="Next File" onAction="#nextFile"/>
        </HBox>


    </VBox>
</AnchorPane>
