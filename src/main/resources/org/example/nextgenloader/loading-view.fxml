<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.nextgenloader.LoadingController"
            prefHeight="485.0" prefWidth="300.0">

    <VBox alignment="CENTER" spacing="20.0" xmlns:fx="http://javafx.com/fxml">
        <Label fx:id="loadingLabel" text="Loading Files"/>
        <HBox alignment="CENTER" spacing="30.0" xmlns:fx="http://javafx.com/fxml">

            <Button fx:id="lastFileButton" text="Last file" onAction="#lastFile"/>
            <Button fx:id="nextFileButton" text="Next File" onAction="#nextFile"/>
        </HBox>
    </VBox>
</AnchorPane>
